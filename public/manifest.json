{
	"manifest_version": 3,
	"name": "Saar AI",
	"version": "1.0.0",
	"description": "On-device reading assistant for web pages.",
	"minimum_chrome_version": "138",
	"permissions": [
		"activeTab",
		"scripting",
		"storage",
		"tabs",
		"sidePanel"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Open Saar AI",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"side_panel": {
		"default_path": "index.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}